{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "dist/preload",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": ["src/preload/**/*", "src/shared/**/*"],
  "exclude": ["src/renderer", "src/main", "tests"]
}
