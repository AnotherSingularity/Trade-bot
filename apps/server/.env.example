# ---------------------------------------------------------------------------
# Horizon Trade — server environment
# Copy to .env and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
# Generate with:
#   node -e "import('bcryptjs').then(b=>b.hash('your-password',12).then(console.log))"
ADMIN_PASSWORD_HASH=

# Database (MySQL)
DATABASE_URL=mysql://root:password@localhost:3306/horizon_trade

# Redis (BullMQ job queue)
REDIS_URL=redis://localhost:6379

# Coinbase Advanced Trade (CDP format). Leave blank to run market-data only.
COINBASE_KEY_NAME=organizations/xxx/apiKeys/xxx
COINBASE_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----"

# Anthropic Claude
ANTHROPIC_API_KEY=

# When true, orders are logged but NOT sent to Coinbase (safe demo mode).
DRY_RUN=true

# Phase 1 §Q double-lock: the Coinbase client's createOrder() refuses to
# POST /orders unless this is explicitly true. Leave false during shadow / dry
# runs. Live boot (DRY_RUN=false) requires this to be true.
ORDER_SUBMISSION_ENABLED=false
